import java.util.Scanner;

// Interface for console details[span_8](start_span)[span_8](end_span)
interface iConsole {
    String getConsoleType();
    String getStore();
    int getTotalSales();
}

// Abstract base class[span_9](start_span)[span_9](end_span)
abstract class Console implements iConsole {
    private String consoleType;
    private String store;
    private int totalSales;

    // Constructor[span_10](start_span)[span_10](end_span)
    public Console(String consoleType, String store, int totalSales) {
        this.consoleType = consoleType;
        this.store = store;
        this.totalSales = totalSales;
    }

    // Getters implementing interface methods[span_11](start_span)[span_11](end_span)
    @Override
    public String getConsoleType() {
        return consoleType;
    }

    @Override
    public String getStore() {
        return store;
    }

    @Override
    public int getTotalSales() {
        return totalSales;
    }
}

// Subclass extending Console[span_12](start_span)[span_12](end_span)
class ConsoleSales extends Console {

    public ConsoleSales(String consoleType, String store, int totalSales) {
        super(consoleType, store, totalSales);
    }

    // Displays formatted console sales report[span_13](start_span)[span_13](end_span)[span_14](start_span)[span_14](end_span)
    public void printReport() {
        System.out.println("--------------------------------------------------");
        System.out.println("CONSOLE SALES REPORT");
        System.out.println("--------------------------------------------------");
        System.out.println("CONSOLE TYPE: " + getConsoleType());
        System.out.println("STORE: " + getStore());
        System.out.println("TOTAL SALES: " + getTotalSales());
        System.out.println("--------------------------------------------------");
    }
}

// Main class to run application[span_15](start_span)[span_15](end_span)
public class RunApplication {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Display console menu[span_16](start_span)[span_16](end_span)
        System.out.println("Select the console type:");
        System.out.println("1) PS5");
        System.out.println("2) XBOX");
        System.out.println("3) SWITCH");

        int choice = sc.nextInt();
        sc.nextLine(); // Clear buffer

        String consoleType = "";
        switch (choice) {
            case 1:
                consoleType = "PS5";
                break;
            case 2:
                consoleType = "XBOX";
                break;
            case 3:
                consoleType = "SWITCH";
                break;
            default:
                consoleType = "PS5";
                break;
        }

        // Get user inputs[span_17](start_span)[span_17](end_span)[span_18](start_span)[span_18](end_span)
        System.out.print("Enter the store name: ");
        String storeName = sc.nextLine();

        System.out.print("Enter the total sales of " + consoleType + " consoles for " + storeName + ": ");
        int totalSales = sc.nextInt();

        System.out.println(); // Spacing

        // Create object and generate output report[span_19](start_span)[span_19](end_span)[span_20](start_span)[span_20](end_span)
        ConsoleSales report = new ConsoleSales(consoleType, storeName, totalSales);
        report.printReport();

        sc.close();
    }
}
